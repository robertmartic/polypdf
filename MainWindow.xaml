<Window x:Class="PolyPDF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PolyPDF" Icon="assets/polypdf.ico" Width="1280" Height="860" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FilesDropped" Closing="WindowClosing">
 <Grid Background="{DynamicResource WindowBg}">
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
   <DockPanel Margin="20,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="assets/polypdf.png" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="12,0,28,0" VerticalAlignment="Center"><TextBlock Text="PolyPDF" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SoftwareVersion" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"><Button x:Name="UpdateNotice" Content="Update available" Visibility="Collapsed" Click="UpdateNoticeClick"/><Button Content="Theme" Click="ThemeClick" ToolTip="Switch light / dark theme"/><Button Content="About" Click="AboutClick"/></StackPanel>
    <StackPanel x:Name="FileActions" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Open PDF" Style="{StaticResource Primary}" Click="OpenClick" ToolTip="Ctrl+O"/><Button Content="New" Click="NewClick"/><Button x:Name="SaveButton" Content="Save" Click="SaveClick" ToolTip="Ctrl+S"/><Button Content="Save as…" Click="SaveAsClick"/><Button Content="Print" Click="PrintClick"/></StackPanel>
   </DockPanel>
  </Border>
  <TabControl x:Name="Documents" Grid.Row="1" SelectionChanged="DocumentChanged" Background="{DynamicResource WindowBg}" BorderThickness="0" Margin="16,9,16,0"/>
  <Border x:Name="Toolbar" Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Margin="0,8,0,0">
   <StackPanel>
    <DockPanel Margin="16,5">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Undo" Click="UndoClick"/><Button Content="Redo" Click="RedoClick"/></StackPanel>
     <StackPanel Orientation="Horizontal"><RadioButton x:Name="ViewTab" Content="View" GroupName="ToolGroups" IsChecked="True" Style="{StaticResource SelectionTab}" Checked="ViewToolsClick"/><RadioButton x:Name="AnnotateTab" Content="Annotate" GroupName="ToolGroups" Style="{StaticResource SelectionTab}" Checked="AnnotateToolsClick"/><RadioButton x:Name="PagesTab" Content="Pages" GroupName="ToolGroups" Style="{StaticResource SelectionTab}" Checked="PageToolsClick"/><Border Width="1" Background="{DynamicResource LineBrush}" Margin="12,7"/><TextBlock x:Name="ToolHint" Text="Drag to select text. Ctrl+F to search." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></StackPanel>
    </DockPanel>
    <WrapPanel x:Name="ViewTools" Margin="18,0,18,7"><Button Content="Select text" Click="SelectClick"/><Button Content="Copy page text" Click="CopyClick"/><TextBox x:Name="SearchBox" Width="170" ToolTip="Search document" KeyDown="SearchKeyDown"/><Button Content="Find next" Click="SearchClick"/><Button Content="Comments" Click="CommentsClick"/><Button Content="OCR page" Click="OcrClick"/><Button Content="Export PNG" Click="ExportClick"/></WrapPanel>
    <WrapPanel x:Name="AnnotateTools" Margin="18,0,18,7" Visibility="Collapsed"><Button Content="Add text" Click="AddTextClick"/><RadioButton x:Name="MoveTextButton" Content="Move text" GroupName="AnnotationMode" Style="{StaticResource SelectionTab}" Click="MoveTextClick"/><Button Content="Edit text" Click="EditTextClick"/><Button Content="Highlight" Click="HighlightClick"/><Button Content="Draw" Click="DrawClick"/><Button Content="Comment" Click="CommentClick"/><TextBlock Text="Size" Margin="14,0,5,0" VerticalAlignment="Center"/><TextBox x:Name="FontSizeBox" Text="14" Width="55"/><ComboBox x:Name="FontChoice" Width="125" Margin="5" SelectedIndex="0"><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Times New Roman"/></ComboBox><ComboBox x:Name="ColorChoice" Width="100" Margin="5" SelectedIndex="0"><ComboBoxItem Content="Blue"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Red"/><ComboBoxItem Content="Green"/></ComboBox></WrapPanel>
    <WrapPanel x:Name="PageTools" Margin="18,0,18,7" Visibility="Collapsed"><Button Content="Rotate ↻" Click="RotateClick"/><Button Content="Move left" Click="MoveLeftClick"/><Button Content="Move right" Click="MoveRightClick"/><Button Content="Add blank" Click="BlankClick"/><Button Content="Delete page" Click="DeleteClick"/><Button Content="Extract pages…" Click="ExtractClick"/><Button Content="Merge PDF…" Click="MergeClick"/></WrapPanel>
   </StackPanel>
  </Border>
  <Grid Grid.Row="3">
   <Grid x:Name="Workspace" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PAGES" Margin="20,18,0,12" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><ListBox x:Name="Thumbnails" SelectionChanged="PageChanged" Background="{DynamicResource PanelBg}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,8,8,10"><Border BorderBrush="#C4CBD8" BorderThickness="1" Background="White"><Image Source="{Binding Preview}" Width="108" Stretch="Uniform"/></Border><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    <ScrollViewer x:Name="PageScroll" Grid.Column="1" Background="{DynamicResource CanvasBg}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageMouseWheel">
     <Grid Margin="28" HorizontalAlignment="Center" VerticalAlignment="Top"><Border Background="White"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.14"/></Border.Effect><Grid><Image x:Name="PageImage" Stretch="Fill"/><Canvas x:Name="PageOverlay" Focusable="True" Background="Transparent" MouseLeftButtonDown="PageMouseDown" MouseMove="PageMouseMove" MouseLeftButtonUp="PageMouseUp" LostMouseCapture="PageLostMouseCapture"/></Grid></Border></Grid>
    </ScrollViewer>
   </Grid>
   <Grid x:Name="Welcome" Background="{DynamicResource WindowBg}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"><Border Background="{DynamicResource AccentBrush}" CornerRadius="20" Width="78" Height="78" HorizontalAlignment="Center"><TextBlock Text="P" Foreground="White" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Your PDFs. Your workspace." FontSize="31" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,10"/><TextBlock Text="Read, annotate and organise. Everything stays on your PC." TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0"><Button Content="Open a PDF" Style="{StaticResource Primary}" Padding="25,12" Click="OpenClick"/><Button Content="Create a document" Padding="20,12" Click="NewClick"/></StackPanel><TextBlock Text="or drop PDF files anywhere in this window" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,28"/><TextBlock Text="RECENT DOCUMENTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="8,10"/><ListBox x:Name="RecentFiles" Background="Transparent" BorderThickness="0" MaxHeight="140" MouseDoubleClick="RecentDoubleClick" Foreground="{DynamicResource ForegroundBrush}"/></StackPanel></Grid>
  </Grid>
  <Border Grid.Row="4" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="16,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" Padding="9,2" Click="ZoomOutClick"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="48" VerticalAlignment="Center" TextAlignment="Center"/><Button Content="+" Padding="9,2" Click="ZoomInClick"/><RadioButton x:Name="FitWidthButton" Content="Fit width" GroupName="FitModes" Style="{StaticResource SelectionTab}" Padding="8,2" Checked="FitClick"/><RadioButton x:Name="FitHeightButton" Content="Fit height" GroupName="FitModes" Style="{StaticResource SelectionTab}" Padding="8,2" Checked="FitHeightClick"/></StackPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="Pages" Padding="8,2" Click="SidebarClick"/><Button Content="‹" Padding="10,2" Click="PreviousClick"/><TextBox x:Name="PageNumberBox" Text="0" Width="45" Padding="4,0" KeyDown="PageNumberKeyDown"/><TextBlock x:Name="PageCountLabel" Text="/ 0" VerticalAlignment="Center" Margin="3,0,6,0"/><Button Content="›" Padding="10,2" Click="NextClick"/></StackPanel><TextBlock x:Name="Status" Text="Ready · Local processing" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="18,0" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
