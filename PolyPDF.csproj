<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>PolyPDF</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/polypdf.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <Authors>PolyPDF contributors</Authors>
    <Description>A local, open-source PDF workspace for Windows.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);vendor/**;dist/**;tests/**;tmp/**;output/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets/polypdf.ico" />
    <Resource Include="assets/polypdf.png" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="PolyPDF.CHANGELOG.md" />
    <Content Include="vendor/pdfium-package/runtimes/win-x64/native/pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor/licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
